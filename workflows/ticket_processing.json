        "responses": {
          "values": [
            {
              "content": "=You are an AI support ticket classifier.\n\nAnalyze the support ticket and return STRICT JSON only.\n\nTicket Information:\nName: {{ $json.name }}\nEmail: {{ $json.email }}\nSubject: {{ $json.subject }}\nMessage: {{ $json.message }}\n\nClassify the ticket and return the following JSON structure:\n\n{\n  \"category\": \"billing | technical | account | refund | other\",\n  \"urgency\": \"critical | high | medium | low\",\n  \"sentiment\": \"positive | neutral | negative\",\n  \"confidence\": 0-1,\n  \"summary\": \"short summary of the issue\"\n}\n\nRules:\nReturn ONLY JSON.\nNo explanation.\nNo text outside JSON.\nConfidence must be between 0 and 1.\n\nIf the message does not clearly describe a specific problem, set confidence to 0.4 or lower."
            },
            {
              "role": "system",
              "content": "You are an AI support ticket classifier.\nReturn JSON only. Do not explain anything.\n\nIf the message does not clearly describe a specific problem, set confidence to 0.4 or lower."
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "temperature": 0
        }
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.1,
      "position": [
        60,
        200
      ],
      "id": "26f0e996-f2aa-404b-8a16-cf9fb3f78e6c",
      "name": "Classify ticket",
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Clean the model output, parse it and check every field before anything else uses it.\nconst ticket = $('Validate ticket').item.json;\nconst CATS = ['billing', 'technical', 'account', 'refund', 'other'];\nconst URG = ['critical', 'high', 'medium', 'low'];\nconst SENT = ['positive', 'neutral', 'negative'];\nlet c = {}, error = null;\ntry {\n  let text = $json.output?.[0]?.content?.[0]?.text ?? '';\n  text = text.replace(/```json/gi, '').replace(/```/g, '').trim();\n  c = JSON.parse(text);\n  const bad = [];\n  if (!CATS.includes(c.category)) bad.push('category');\n  if (!URG.includes(c.urgency)) bad.push('urgency');\n  if (!SENT.includes(c.sentiment)) bad.push('sentiment');\n  c.confidence = Number(c.confidence);\n  if (!(c.confidence >= 0 && c.confidence <= 1)) bad.push('confidence');\n  if (typeof c.summary !== 'string' || !c.summary.trim()) bad.push('summary');\n  if (bad.length) error = 'invalid fields: ' + bad.join(', ');\n} catch (e) {\n  error = 'JSON parse failed: ' + (e.message ?? e);\n}\nconst ok = !error;\nconst words = ticket.message.split(/\\s+/).filter(Boolean).length;  // too short to say what the problem is\nconst status = !ok ? 'validation_error' : (c.confidence < 0.6 || words < 5 ? 'needs_manual_review' : 'opened');\nreturn { json: {\n  name: ticket.name, email: ticket.email, subject: ticket.subject, message: ticket.message,\n  category: ok ? c.category : 'unknown',\n  urgency: ok ? c.urgency : 'unknown',\n  sentiment: ok ? c.sentiment : 'unknown',\n  confidence: ok ? c.confidence : 0,\n  summary: ok ? c.summary : 'AI classification could not be validated',\n  status, error,\n  processing_log: `validated -> classified (${status})`,\n} };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
