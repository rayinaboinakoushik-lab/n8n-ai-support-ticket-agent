      "parameters": {
        "jsCode": "// Normalise the request and check required fields + email format.\nconst b = $json.body ?? $json;\nconst t = {\n  name: String(b.name ?? '').trim(),\n  email: String(b.email ?? '').trim(),\n  subject: String(b.subject ?? '').trim(),\n  message: String(b.message ?? '').trim(),\n};\nconst reasons = Object.keys(t).filter(k => !t[k]).map(k => `missing ${k}`);\nif (t.email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(t.email)) reasons.push('invalid email format');\nreturn { json: { ...t, valid: reasons.length === 0, rejection_reason: reasons.join(', ') } };",
