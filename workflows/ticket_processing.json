    {
      "parameters": {
        "jsCode": "// Qdrant returns one item per chunk. Combine them into ONE item, so everything after runs once.\nconst ticket = $('Parse & validate classification').first().json;\nconst chunks = $input.all()\n  .map(i => ({ text: i.json.document?.pageContent ?? '', score: Number(i.json.score ?? 0) }))\n  .filter(c => c.text.trim());\nconst top = chunks.length ? Math.max(...chunks.map(c => c.score)) : 0;\nreturn [{ json: {\n  ...ticket,\n  context: chunks.map((c, i) => `[${i + 1}] (similarity ${c.score.toFixed(2)})\\n${c.text}`).join('\\n\\n'),\n  top_score: top,\n  knowledge_sources: chunks.length ? `Qdrant KB (${chunks.length} chunks, top ${top.toFixed(2)})` : 'none',\n  processing_log: `${ticket.processing_log} -> retrieved ${chunks.length} chunks (top ${top.toFixed(2)})`,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        100
